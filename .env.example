# ============================================================================
# Transcodarr — infrastructure configuration
# The ONLY file you need to edit. Everything operational (bitrate ladders,
# HDR/DV policies, tool paths, dry-run…) is then set in the web UI and stored
# in the database.
# ============================================================================

# Network
HTTP_PORT=8080

# Database
POSTGRES_USER=transcoder
POSTGRES_PASSWORD=change_me
POSTGRES_DB=transcoder

# Media paths: mounted at the SAME absolute path inside the container
# (${MEDIA_ROOT}:${MEDIA_ROOT})
MEDIA_ROOT=/srv/storage                          # common parent of all your libraries
SANDBOX_ROOT=/srv/storage/_transcoder_sandbox    # burn-in sample folder (see README)

# GPU
DRI_DEVICE=/dev/dri
RENDER_GID=993        # getent group render | cut -d: -f3

# Safety (INITIAL values, seeded into the database on first start —
# managed in the UI afterwards; this file no longer overrides them)
DRY_RUN=true          # true = encodes but NEVER replaces the original
TRASH_RETENTION_DAYS=14
MAX_CONCURRENT_JOBS=1

# App identity (must be able to read/write your media files)
PUID=1000
PGID=1000

# ============================================================================
# Transcodeur Jellyfin — configuration d'infrastructure (§9.2)
# SEUL fichier à éditer. Toute la config d'exploitation (bitrates, politiques,
# chemins d'outils, dry-run…) se règle ensuite dans l'UI et vit en base.
# ============================================================================

# Réseau
HTTP_PORT=8080

# Base de données
POSTGRES_USER=transcoder
POSTGRES_PASSWORD=change_me
POSTGRES_DB=transcoder

# Chemins médias : montés à l'IDENTIQUE dans le conteneur (${MEDIA_ROOT}:${MEDIA_ROOT})
MEDIA_ROOT=/srv/storage                          # parent commun de Films / Séries / Animés
SANDBOX_ROOT=/srv/storage/_transcoder_sandbox    # dossier de rodage (§9.4)

# GPU
DRI_DEVICE=/dev/dri
RENDER_GID=993        # getent group render | cut -d: -f3

# Sécurité d'exploitation (valeurs INITIALES seedées en base au premier
# démarrage — modifiables ensuite dans l'UI, ce fichier ne les écrase plus)
DRY_RUN=true          # true = encode mais NE REMPLACE JAMAIS l'original
TRASH_RETENTION_DAYS=14
MAX_CONCURRENT_JOBS=1

# Identité de l'app (doit pouvoir lire/écrire les médias)
PUID=1000
PGID=1000
